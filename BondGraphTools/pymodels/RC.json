{
  "id": "my_comp_lib",
  "description": "My Custom Components",
  "components": {
    "RCBlock": {
      "description": "Resistor + Capacitor block",
      "class": "Composite",
      "subcomponents": {
        "R": {"type": "R", "value": 1.0},
        "C": {"type": "C", "value": 2.0},
        "one":  {"type": "1"}
      },
      "connections": [
        ["R", "one"],
        ["C", "one"]
      ],
      "expose_ports": {
        "one": "P"
      }
    },
    "DoubleRC": {
        "description": "Two RCBlocks in series",
        "class": "Composite",
        "subcomponents": {
            "rc1": {"type": "RCBlock"},
            "rc2": {"type": "RCBlock"}
        },
        "connections": [
            
        ],
        "expose_ports": {
            "rc1": "Input",
            "rc2": "Output"
        }
    }
  }
}
